{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulse",
  "version": "2.2.0",
  "identifier": "com.zephyrzz.pulse",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pulse \u00e2\u20ac\u201d overview",
        "width": 1180,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/pulse.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "targets": [
      "msi",
      "nsis",
      "appimage"
    ],
    "copyright": "Copyright \u00c2\u00a9 Z3PHYRZZ",
    "category": "Utility",
    "shortDescription": "Native Windows system monitor",
    "longDescription": "Pulse is a native Windows system monitor built with Tauri, Rust and an accessible React interface."
  }
}
